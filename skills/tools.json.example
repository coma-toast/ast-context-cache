{
  "execute_code": {
    "enabled": false,
    "tier": "complete",
    "description": "Disabled by policy"
  },
  "index_files": {
    "enabled": true,
    "tier": "core",
    "description": "Allow indexing when server runs at AST_MCP_TIER=core"
  },
  "store_context": {
    "enabled": true,
    "tier": "extended",
    "description": "Virtual context offload before host compaction (default tier)"
  },
  "flush_context": {
    "enabled": true,
    "tier": "extended",
    "description": "Delete stored virtual context to free quota"
  },
  "scratchpad": {
    "enabled": false,
    "tier": "core",
    "description": "Hidden from tools/list by policy. tools.json is read at startup and can only hide or re-tier a tool; to switch a whole feature on or off live use its feature flag (feature_handoff_scratchpad, AST_FEATURE_HANDOFF_SCRATCHPAD). A tool is listed only when its flag, tools.json, and the tier all allow it."
  }
}
