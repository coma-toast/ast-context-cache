{
  "$schema": "https://opencode.ai/config.json",
  // theme and model
  "theme": "system",
  "model": "anthropic/claude-sonnet",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "ast-context-cache": {
      "type": "remote",
      "url": "http://127.0.0.1:7821/mcp",
      "enabled": true
    },
  },
}
