{
  // user hooks
  "version": 1,
  "hooks": {
    "preToolUse": [
      { "command": "./hooks/guard-shell.sh", "matcher": "Shell" },
      {
        "command": "/opt/ast/bin/ast-mcp hook cursor-search-nudge",
        "matcher": "Read|Grep|Glob|MCP:.*",
        "timeout": 3
      }
    ],
    "beforeShellExecution": [
      { "command": "./hooks/audit.sh" }
    ]
  }
}
